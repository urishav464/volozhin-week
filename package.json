{
  "name": "volozhin-week",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "שבוע וולוז'ין — מערכת התכנון והשיבוץ (המדרשה הגבוהה עין פרת)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run --project unit",
    "test:sql": "vitest run --project sql",
    "test:e2e": "playwright test",
    "pg:up": "node scripts/pg.mjs up",
    "pg:down": "node scripts/pg.mjs down",
    "scan:pii": "node scripts/pii-scan.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "docx": "9.8.1",
    "fflate": "0.8.2",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "pg": "8.23.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
